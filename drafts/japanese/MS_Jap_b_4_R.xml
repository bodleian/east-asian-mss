                    <head/>
                    <msContents>
                        <summary>Painted handscroll narrating the Tale of Yang Guifei (楊貴妃物語) by
                            Asai Ryōi (1612-1691), a Japanese adaptation of Bai Juyi's (772-846)
                            Tang dynasty poem, Song of Everlasting Sorrow (長恨歌).</summary>
                        <textLang mainLang="ja">Japanese</textLang>
                        <msItem>

                            <title key="">長恨歌</title>
                            <title key="">Chōgonka</title>

                        </msItem>
                    </msContents>
                    <physDesc>
                        <objectDesc form="roll">
                            <supportDesc material="paper">
                                <support>Torinoko paper with gold underdrowings.</support>
                                <extent>Two scrolls; upper and middle scrolls only; lower scroll is
                                    not extant. </extent>
                            </supportDesc>
                        </objectDesc>

                        <bindingDesc>
                            <binding>
                                <p>Olive-green covers decorated with gold patterns; ivory roller
                                    ends.</p>

                            </binding>
                        </bindingDesc>
                    </physDesc>
                    <history>
                        <origin>
