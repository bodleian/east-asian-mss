                    <head/>
                    <msContents>
                        <summary>Complete set of eight scrolls containing the <title>Lotus
                                Sutra</title> (<term xml:lang="ja">妙法蓮華經</term>).</summary>
                        <textLang mainLang="zh">Chinese</textLang>
                        <msItem>

                            <title xml:lang="ja">妙法蓮華經</title>
                            <title xml:lang="ja-Latn">Myōhō Rengekyō</title>

                        </msItem>
                    </msContents>
                    <physDesc>
                        <objectDesc form="roll">
                            <supportDesc material="paper">
                                <support> Indigo-dyed paper with text written in gold ink (<term
                                        xml:lang="ja">紺紙金字経</term>). </support>
                                <extent>Eight handscrolls. <dimensions unit="cm" type="roll">
                                        <height>28</height>
                                        <width>1050</width>
                                    </dimensions></extent>
                            </supportDesc>
                        </objectDesc>

                        <bindingDesc>
                            <binding>
                                <p> Covers of dark blue paper decorated in gold and silver pigment. </p>
                                <decoNote>Gold-painted front endpaper.</decoNote>
                                <decoNote> Crystal roller ends. </decoNote>

                                <p> Housed in two lacquered boxes together with MS.Ind.Inst.misc.25,
                                    MS.Ind.Inst.misc.26, MS.Ind.Inst.misc.27/1–8,
                                    MS.Ind.Inst.misc.28, MS.Ind.Inst.misc.29,
                                    MS.Ind.Inst.misc.31/1–8. </p>

                            </binding>

                        </bindingDesc>
                    </physDesc>
